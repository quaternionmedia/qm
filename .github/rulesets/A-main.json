{
  "name": "A - main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "tests"
          },
          {
            "context": "adr-lint"
          },
          {
            "context": "check"
          },
          {
            "context": "reuse"
          },
          {
            "context": "signatures"
          },
          {
            "context": "slot"
          },
          {
            "context": "symlinks"
          }
        ]
      }
    },
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "No unmonitored co-author trailer",
        "operator": "regex",
        "pattern": "(?i)co-authored-by:.*noreply",
        "negate": true
      }
    }
  ]
}
